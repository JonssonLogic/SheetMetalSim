#

# Merge Models Options
#
# - mm_default_id_settings:
#    - Merge Option: (Offset all auto-id | Offset all by value | Offset conflicts auto-id | Offset conflicts by value)
#    - Offset Value: (Max id of model | Max id of Id Group | <A specific number, e.g. 100000> | <Empty>)
#    - Resolve Undefined: (true | false)
#    Example: mm_default_id_settings: Merge Option = Offset all by value || Offset Value = Max id of model || Resolve Undefined = true
#
# - mm_advanced_id_settings:
#    - Id Group: A group of types that shares the same id pool and the same id settings
#    - Merge Option: (Offset all auto-id | Offset all by value | Offset conflicts auto-id | Offset conflicts by value | Keep Base Model at conflicts | Keep Merging Model at conflicts | Merge by id) (Last 3 options are available on specific Id Groups)
#    - Offset Value: Same as on "mm_default_id_settings"
#    - Resolve Undefined: Same as on "mm_default_id_settings"
#    Example: mm_advanced_id_settings: Id Group = NODE || Merge Option = Offset all by value || Offset Value = Max id of model || Resolve Undefined = true
#
    mm_default_id_settings        = Merge Option = Offset all auto-id || Offset Value =  || Resolve Undefined = true
    mm_hide_ansa_only_conflicts   = true
    mm_launch_advanced_mode_first = false
