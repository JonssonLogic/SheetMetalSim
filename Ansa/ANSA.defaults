# 

# Export PLMXML Options
# 
# Describes what structural information should be output to the PLMXML file.
# Allowed values are:
# "Hierarchy": information about all selected parts and their (recursive)
# children will be exported, together with assembly relationship.
# "Monolithic": selected parts are exported with a monolithic representation
# file that aggregates all respective contained parts.
# "Flat": information about all selected parts and their (recursive) children
# will be exported, but the assembly relationships not.
    export_plmxml.structure_info         = Hierarchy
# Describes what representation info should be output to the PLMXML file.
# Allowed values are:
# "Current": the currently active representation for each part will be
# packaged and referenced from the PLMXML file.
# "All": for each part the currently active one, plus all others found in DM
# will be packaged and referenced from the PLMXML file.
# "None": no representation related files will be packaged.
    export_plmxml.representation_info    = Current
# Defines whether the referenced files directory (accompanying the PLMXML
# file) will contain the packaged files in a nested or flattened directory
# structure.
    export_plmxml.flatten_files          = false
# Defines how the different kinds of packaged files should be described in
# the PLMXML file. This information is expressed as a JSON array holding
# objects per different kind of file that can be handled. For each kind of
# file to be handled, the following information is required: file extension,
# Dataset type, AssociatedDataset role. These properties are expressed in the
# JSON object as 'ext', 'dt' and 'adr' members respectively.
# 
# An example of an encoded string describing e.g. the handling of JT files is
# {"ext":"jt", "dt":"DirectModel","adr":"IMAN_Rendering"}
# 
# The JSON array describing the different kinds of files handled is then
# composed out of the different per file extension objects in an array. E.g.:
# [<ansa_file_handling>, <jt_file_handling>, <png_file_handling>]
# 
    export_plmxml.file_handling          = [{"ext":"ansa","dt":"T4T_ANSA","adr":"IMAN_specification"},{"ext":"jt","dt":"DirectModel","adr":"IMAN_Rendering"},{"ext":"png","dt":"Image","adr":"IMAN_specification"}]
# Defines whether a JT image should be included in the PLMXML package for
# each part.
    export_plmxml.export_jt              = false
# Defines whether a PNG image should be included in the PLMXML package for
# each part.
    export_plmxml.export_png             = false
# Defines whether the various attached files should be included in the PLMXML
# package for each part.
    export_plmxml.export_attachments     = false
# Defines whether the different User Attributes should be included in the PLMXML
# description for each part.
    export_plmxml.export_user_attributes = true
# Defines whether the Part names should be transformed during export: if the
# Module ID + Version appear as prefix (underscore as separators), then they
# will be trimmed from the Part name in the PLMXML file.
    export_plmxml.convert_part_names     = true
# Defines whether the files that are flattened should be renamed or not.
# This renaming incorporates all property values into the file name, in
# order to avoid collisions.
    export_plmxml.rename_flattened_files = true
# Defines whether the in-memory representations of the output parts
# should be saved, or files should be directly looked up in the current
# DM.
    export_plmxml.skip_save              = false
# Defines whether the part related files should be downloaded from the
# DM, or should be referenced in the PLMXML file without actually being
# downloaded. If this option is set, it is expected that the actual
# files will be provided via an external mechanism.
    export_plmxml.skip_download          = false
# If both Save / Download are to be skipped, then this option defines which
# part attribute should be queried to get the file to be used as placeholder,
# in case the part is not found in the DM.
    export_plmxml.fallback_file_attr     = 
# Annotation options
    annotations_template_file_path                            = 
# Annotation options
    annotations_load_templates_to_annotations_during_creation = false
