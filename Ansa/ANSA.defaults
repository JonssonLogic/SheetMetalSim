# Default Page for Bolt_Type
# format : BOLT|BOLT ON SOLID|SOLID BOLT|BEAM BOLT|
#          BOLT RIGID PATCHES|RADIOSS BOLT|HYBRID BOLT|
#          PRESTRESSED ABAQUS BOLT|BOLT NULL SHELL
    Bolt_Type          = BOLT
# Default Page for Rivet_Type
# format : RBE2|RBAR|CBAR|CBEAM|CELAS2|RBE2-CELAS1-RBE2|
#          PASTED NODES|CBUSH|DYNA SPOT WELD|NASTRAN CWELD|
#          PAM PLINK|RBE3-HEXA-RBE3|AUTO SP2|
#          RBE3-CBUSH-RBE3|SPIDER|RADIOSS WELD|
#          ABAQUS FASTENER|SPIDER2|RBE3-CELAS1-RBE3|
#          RBE3-CBAR-RBE3|RBE3-CBEAM-RBE3|PERMAS SPOTWELD|
#          TIE CONN3D|RBE3|FEMFAT SPOT|CGAP|CFAST|
#          IQUAD-HEXA-IQUAD|IQUAD-SPRING-IQUAD|
#          SOLID NUGGET|RADIOSS-CLUSTER|CONSTRAINED-SPR2|
#          COUPLING-CONNECTOR|FEMSITE-SPOTWELD|
#          CONSTRAINED_INTERPOLATION_SP|SUPERELEMENT|PSE98|
#          SPR-RIVET|PSE2001-RIGID|PSE2001-FLEXIBLE|
#          CBUSH-CBAR-CBUSH|IMPETUS CONNECTOR|ANSYS BEAM|
#          ANSYS JOINT|ANSYS HEXA|FEMSITE-SPOTWELD 2.0
    Rivet_Type         = RBE2
# Default Page for Screw_Type
# format : RBE2|RBAR|CBAR|CBEAM|CELAS2|RBE2-CELAS1-RBE2|
#          PASTED NODES|CBUSH|DYNA SPOT WELD|NASTRAN CWELD|
#          PAM PLINK|RBE3-HEXA-RBE3|AUTO SP2|
#          RBE3-CBUSH-RBE3|SPIDER|RADIOSS WELD|
#          ABAQUS FASTENER|SPIDER2|RBE3-CELAS1-RBE3|
#          RBE3-CBAR-RBE3|RBE3-CBEAM-RBE3|PERMAS SPOTWELD|
#          TIE CONN3D|RBE3|FEMFAT SPOT|CGAP|CFAST|
#          IQUAD-HEXA-IQUAD|IQUAD-SPRING-IQUAD|
#          SOLID NUGGET|RADIOSS-CLUSTER|CONSTRAINED-SPR2|
#          COUPLING-CONNECTOR|FEMSITE-SPOTWELD|
#          CONSTRAINED_INTERPOLATION_SP|SUPERELEMENT|PSE98|
#          SPR-RIVET|PSE2001-RIGID|PSE2001-FLEXIBLE|
#          CBUSH-CBAR-CBUSH|IMPETUS CONNECTOR|ANSYS BEAM|
#          ANSYS JOINT|ANSYS HEXA|FEMSITE-SPOTWELD 2.0
    Screw_Type         = RBE2
# Default Page for SpotweldLine_Type
# format : RBE2|RBAR|CBAR|CBEAM|CELAS2|RBE2-CELAS1-RBE2|
#          PASTED NODES|CBUSH|DYNA SPOT WELD|NASTRAN CWELD|
#          PAM PLINK|RBE3-HEXA-RBE3|AUTO SP2|
#          RBE3-CBUSH-RBE3|SPIDER|RADIOSS WELD|
#          ABAQUS FASTENER|SPIDER2|RBE3-CELAS1-RBE3|
#          RBE3-CBAR-RBE3|RBE3-CBEAM-RBE3|PERMAS SPOTWELD|
#          TIE CONN3D|RBE3|FEMFAT SPOT|CGAP|CFAST|
#          IQUAD-HEXA-IQUAD|IQUAD-SPRING-IQUAD|
#          SOLID NUGGET|RADIOSS-CLUSTER|CONSTRAINED-SPR2|
#          COUPLING-CONNECTOR|FEMSITE-SPOTWELD|
#          CONSTRAINED_INTERPOLATION_SP|SUPERELEMENT|PSE98|
#          SPR-RIVET|PSE2001-RIGID|PSE2001-FLEXIBLE|
#          CBUSH-CBAR-CBUSH|IMPETUS CONNECTOR|ANSYS BEAM|
#          ANSYS JOINT|ANSYS HEXA|FEMSITE-SPOTWELD 2.0
    SpotweldLine_Type  = RBE3-HEXA-RBE3
# Default Page for AdhesiveLine_Type
# format : RBE3-HEXA-RBE3|HEXA-CONTACT|PAM-LLINK|
#          RBE3-CELAS1-RBE3|RBE3-COHESIVE-RBE3|
#          COHESIVE-CONTACT|PAM-SLINK|CONTACT|PASTED HEXAS|
#          RBE2-HEXA-RBE2|IQUAD-HEXA-IQUAD|MPC-HEXA-MPC|
#          RADIOSS WELD|MPC-CBUSH-MPC|IMPETUS CONNECTOR|
#          RBE3-CBEAM-RBE3
    AdhesiveLine_Type  = RBE3-HEXA-RBE3
# Default Page for SeamLine_Type
# format : RBE2|RBE2-CBEAM|PAM-ELINK|RBE3|RBAR-SHELL|
#          CONTACT|RBE3-HEXA-RBE3|Y-JOINT-SHELL|
#          OVERLAP-SHELL|CRIMP-WELD-SHELL|LASER-WELD-SHELL|
#          EDGE-WELD-SHELL|Y-JOINT-FEMFAT|OVERLAP-FEMFAT|
#          CRIMP-WELD-FEMFAT|LASER-WELD-FEMFAT|
#          EDGE-WELD-FEMFAT|NASTRAN CWELD|SHELL-CONTACT|
#          HEXA-CONTACT|SHELL-RBE3|IQUAD-HEXA-IQUAD|
#          RBE3-PENTA-RBE3|RBE3-CBUSH-RBE3|BEAM-CONTACT|
#          T-JOINT-SHELL-CLOSED|
#          T-JOINT-SHELL-DOUBLE-CLOSED|
#          OVERLAP-SHELL-CLOSED|LASER-WELD-SHELL-CLOSED|
#          RBE3-SHELL-RBE3|RBE3-CONNECTOR-RBE3|
#          PENTA-CONTACT-ON-SOLIDS|SPLIT-CLOSED-SHELL|
#          SOLID-WELD|RADIOSS WELD|PSE98|MPC-CBUSH-MPC|
#          CBUSH-CBAR-CBUSH|OVERLAP SOLID|EDGEWELD SOLID|
#          Y-JOINT SOLID|LASER-WELD-SOLID|
#          FEMSITE-SHELLS-ON-SOLIDS|IQUAD|
#          CONSTRAINED-NODAL-RIGID-BODY|SUPER-ELEMENTS
    SeamLine_Type      = RBE2
# Default Page for Hemming_Type
# format : RBE3|FOLDING|PASTED HEXAS|PASTED NODES|
#          RBE3-HEXA-RBE3|CONTACT|PASTED COHESIVES
    Hemming_Type       = RBE3
# Default Page for AdhesiveFace_Type
# format : RBE3-HEXA-RBE3|HEXA-CONTACT|PAM-SLINK|
#          RBE3-COHESIVE-RBE3|COHESIVE-CONTACT|RBE3|
#          IQUAD-HEXA-IQUAD|RBE2-MPC|CONTACT|RBE2|IQUAD
    AdhesiveFace_Type  = RBE3-HEXA-RBE3
# Default Page for Robscan_Type
# format : FEMSITE-ROBSCAN|RBE3-HEXA-RBE3|
#          RBE3-DIAMOND-RBE3|HEXA-CONTACT
    Robscan_Type       = FEMSITE-ROBSCAN
