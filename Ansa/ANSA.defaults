#
# Robscan pattern descriptions
#  each pattern is described by 
#  - the pattern name
#  - the pattern polygon (as sequence 2D points)
#    where X is along the TAN direction of the robscan.
#    The polygon is defined in the normalized range [-1, 1] and is then stretched by the Width and Length of the connection

    robscan_pattern                                                 = "KL", (-0.583333, -1), (-1, 0), (-0.583333, 1), (0.583333, 1), (1, 0), (0.583333, -1)
    robscan_pattern                                                 = "KL_ST", {(-0.5835, -1), (-1, 0), (-0.5835, 1), (0.5835, 1), (1, 0), (0.5835, -1)}, {(-0.8, 0), (0.8, 0)}
    robscan_pattern                                                 = "SP", (-1, -1), (-1, 0), (-1, 0.6), (-0.882353, 1), (0, 1), (0.882353, 1), (1, 0), (1, -1)
    robscan_pattern                                                 = "ST", (-1, 0), (1, 0)
    robscan_patterns_option                                         = ANSA.defaults
    external_polygon_patterns_filename                              = 
