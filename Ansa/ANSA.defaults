# Cache Management Options
# 
# The maximum footprint that the cached files may take up on disk; if
# overcommitment is allowed, then the footprint on disk may transiently cross
# this limit.
    cache.store_size_limit       = 2.00 GBytes
# The disk space that must be free at all times. Caching of additional
# files will be denied if the free space on disk falls below this threshold;
# also clean ups will try to free up space so that the free space gets above
# this threshold.
    cache.reserved_disk_space    = 200.00 MBytes
# The amount of disk space that can be used on top of the store size limit,
# expressed as a fraction of the store size limit. The overcommitted disk
# space is transiently used and will be freed at the first opportunity.
# Valid values: 0.0 - 1.0
    cache.overcommitment_allowed = 0.5
# Boolean value that controls whether the File Cacher is enabled as a
# service or not.
    cache.service_enabled        = true
