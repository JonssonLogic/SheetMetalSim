#
#
# DynaSectionNumSchema.enable (YES | NO)
    DynaSectionNumSchema.enable                = false
#
# Dyna Section Id Numbering Schema Parameters
#
#
#
# DynaSectionNumSchema.SECTION_SHELL         =  XXXXXXXX, Y=Z, Y=1.0
# where X,Y,Z could be one of: [0-9]ESNPTLMIOXYFDBCT
# [0-9](verbatim digit), E(ELFORM), S(SHRF), N(NIP), P(PROPT), T(T1), L(NLOC), M(MAREA), I(IDOF)
# O(OPTION), X(DX), Y(DY), F(ISPLINE), D(IDILA), B(IEBT), C(IDIM), H(ITHELFM)
#
# DynaSectionNumSchema.SECTION_TSHELL        =  XXXXXXXX, Y=Z, Y=1.0
# where X,Y,Z could be one of: [0-9]ESNPQT
# [0-9](verbatim digit), E(ELFORM), S(SHRF), N(NIP), P(PROPT), Q(QR), T(TSHEAR)
#
# DynaSectionNumSchema.SECTION_SOLID         =  XXXXXXXX, Y=Z, Y=1.0
# where X,Y,Z could be one of: [0-9]EAOXYZFDBCT
# [0-9](verbatim digit), E(ELFORM), A(AET), O(OPTION), X(DX), Y(DY), Z(DZ), F(ISPLINE), D(IDILA), B(IEBT), C(IDIM), T(TOLDEF)
#
# DynaSectionNumSchema.SECTION_BEAM          =  XXXXXXXX, Y=Z, Y=1.0
# where X,Y,Z could be one of: [0-9]ECSDFGHJKQ
# [0-9](verbatim digit), E(ELFORM), C(CST), S(SHRF), D(TS1), F(TS2), G(TT1), H(TT2), J(NSLOC), K(NTLOC), Q(QR)
#
# DynaSectionNumSchema.SECTION_BEAM_ELFORM_2 =  XXXXXXXX, Y=Z, Y=1.0
# where X,Y,Z could be one of: [0-9]AITRS
# [0-9](verbatim digit), A(A), I(ISS), T(ITT), R(IRR), S(SA)
#
# DynaSectionNumSchema.SECTION_BEAM_ELFORM_3 =  XXXXXXXX, Y=Z, Y=1.0
# where X,Y,Z could be one of: [0-9]A
# [0-9](verbatim digit), A(A)
#
# DynaSectionNumSchema.SECTION_BEAM_ELFORM_6 =  XXXXXXXX, Y=Z, Y=1.0
# where X,Y,Z could be one of: [0-9]VICORST
# [0-9](verbatim digit), V(VOL), I(INER), C(CA/DOFN1), O(OFFS/DOFN2), R(RRCON), S(SRCON), T(TRCON)
#
# DynaSectionNumSchema.SECTION_SPH           =  XXXXXXXX, Y=Z, Y=1.0
# where X,Y,Z could be one of: [0-9]CHMSDT
# [0-9](verbatim digit), C(CSLH), H(HMIN), M(HMAX), S(SPHINI), D(DEATH), T(START)
#
# DynaSectionNumSchema.SECTION_SEATBELT      =  XXXXXXXX, Y=Z, Y=1.0
# where X,Y,Z could be one of: [0-9]
# [0-9](verbatim digit), 
#
# DynaSectionNumSchema.SECTION_DISCRETE      =  XXXXXXXX, Y=Z, Y=1.0
# where X,Y,Z could be one of: [0-9]DKVCFLT
# [0-9](verbatim digit), D(DRO), K(KD), V(V0), C(CL), F(FD), L(CDL), T(TDL)
#
# DynaSectionNumSchema.SECTION_COHESIVE         =  XXXXXXXX, Y=Z, Y=1.0
# where X,Y,Z could be one of: [0-9]EOXYZFDBCT
# [0-9](verbatim digit), E(ELFORM), O(OPTION), X(DX), Y(DY), Z(DZ), F(ISPLINE), D(IDILA), B(IEBT), C(IDIM), T(TOLDEF)
#
# Upper case letters stand for the integral part of the number.
# Lower case letters stand for the decimal  part of the number.
#
#
#
#
#
# Paste grids options
