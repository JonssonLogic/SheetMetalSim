#
#
#
# Handle convertion of old ABAQUS GK3D (gasket) elements read from an ANSA database:
# The convertion is needed only if the model previously
# contained ABAQUS GK3D (gasket) elements.
# Set 'convert_old_to_new_ABAQUS_gasket_elements = no' to disable convertion.
# Set 'convert_old_to_new_ABAQUS_gasket_elements = yes' to enable convertion.
# Set 'convert_old_to_new_ABAQUS_gasket_elements = ask' to be asked for the convertion.
    convert_old_to_new_ABAQUS_gasket_elements = ask
