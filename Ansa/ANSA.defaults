# 
# map mcf subtypes to particular ANSA-connection types
#  example: rivet, Bolt_Type, Rivet
#   when ANSA reads a "<type>rivet</type>" it will parse it as a "<type>bolt</type>" 
#   and create a Bolt_Type connection with the keyword "Rivet" in its "mcf_subtype" column
#  On output to mcf, any Bolt_Type that has the "Rivet" keyword, 
#  be written back as "<type>rivet</type>" in the mcf file
# 
# 
# map vip2 subtypes to particular ANSA-connection types
#  example: 0d-clinch, SpotweldPoint_Type, clinch
#   will create a SpotweldPoint_Type in ANSA when it reads a 0d-clinch,
#   and will store the keyword "clinch" in the "vip2_subtype" column
#  On output to vip2, any SpotweldPoint_Type that has the "clinch" keyword, 
#  be written out "0d-clinch" in the vip2 file
# 
    vip2_subtype                                      = 0d-clinch, SpotweldPoint_Type, clinch
    vip2_subtype                                      = 0d-rivet, SpotweldPoint_Type, rivet
    vip2_subtype                                      = 0d-blind_rivet, SpotweldPoint_Type, blind_rivet
    vip2_subtype                                      = 0d-proj_weld, SpotweldPoint_Type, proj_weld
