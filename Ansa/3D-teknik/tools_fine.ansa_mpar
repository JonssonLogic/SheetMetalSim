#===FILEINFO:VERSION_CREATED:25.1.1 LAST_VERSION_MODIFIED:25.1.1===
#
# ANSA Version
#
    ANSA_Version = 25.1.1
#
# Mesh parameters
#
    mesh_parameters_name                    = tools_stl
    mesh_parameters_delimiter               = ||
#
# Basic
#
#
# General
#
# Tool surfaces (die, blankholder, punch) are rigid. Element quality and
# time step are irrelevant for them; only how faithfully the mesh follows
# the real radii matters. Rigid bodies do not contribute to the LS-DYNA
# time step, so a dense mesh here is close to free.
#
# This was originally an STL (chordal-deviation) mesh, which is the natural
# fit. ANSA's STL mesher produced zero elements on these macros under every
# invocation tried - see docs/open-decisions.md. So instead this uses the
# same General mesher that already works, tuned hard for curvature.
#
# The blank keeps mesh_feature_parameters.ansa_mpar (General, 4 mm quads).
#
# RADII: general_curvature_minimum_length is the main knob - it is the floor
# on element size where the surface curves, so it sets how finely a die or
# punch radius is resolved. distortion-distance/-angle control how finely the
# CONS (macro boundaries) are split, which matters at the tangent lines where
# a radius meets a flat. Tighten those four together; tightening only
# target_element_length refines the flats and leaves the radii as they were.
#
# Cost is element count only. Rigid bodies do not contribute to the LS-DYNA
# time step, so this is nearly free in the solve - but contact search and
# ANSA responsiveness do notice it.
#
# CURVATURE GRADING (2026-09-07). The aim is the STL-like behaviour: many
# elements only where the surface is tight, few on the flats.
#
# Measured local radii on the filleted CAD: median 9 mm across the whole tool,
# with the actual fillets a small tail at 1-3 mm (2.2% of curved punch edges).
# Two settings were preventing the mesher targeting them:
#
#   recognize_fillets_max_radius was 20 mm, so with 9 mm general curvature most
#   of the part counted as a fillet and the treatment could not target anything.
#   Now 5 mm, so only genuinely tight radii are treated.
#
#   rows_option was "auto", which derives the row count from
#   target_element_length - that is why the fillets went from 2 to 3 elements
#   when the target was halved for run 12, rather than being set by geometry.
#   Now "number" with rows_number = 6, fixed regardless of the target.
#
# general_curvature_minimum_length lowered 0.25 -> 0.1 so the floor cannot block
# 6 rows across a 1 mm radius (arc 1.57 mm / 6 = 0.26 mm per element).
#
# FILLET ROWS (2026-09-07, verified against a GUI-saved mpar).
#
# rows_option = "specific" with rows_number = N puts exactly N element rows
# across every recognised fillet, independent of target_element_length. This is
# the STL-like behaviour originally wanted: coarse flats, fine fillets.
#
# The value is "specific" - NOT "number", which was guessed earlier by analogy
# with treatment_flange_2d and caused a syntax error that stopped the whole file
# loading. "specific" appears in no shipped .ansa_mpar; it was only found by
# setting the treatment by hand in ANSA's Feature Manager and saving the params.
# For anything in this file that is not already here, do that rather than infer.
#
# ANSA's own saved file created a second rule/treatment pair and applied it to
# hand-selected features. That is not reproducible from a script, so the row
# count goes on the DEFAULT treatment instead - every recognised fillet gets it,
# and recognize_fillets_max_radius decides what counts as a fillet.
#
# recognize_fillets_max_radius = 8, not ANSA's default 20. Measured local
# radius distribution on the tools (share of curved edges):
#
#     0-5 mm    4-9%     the fillets
#     5-8 mm    ~9%      smaller curved faces
#     8-12 mm   63-70%   the bulk part shape
#     12-20 mm  17-19%
#
# 8 is the last threshold below the dominant 8-12 mm band. Raising it to 10
# would catch 54% of curved edges and give 4 rows across most of the part;
# at 20, essentially everything.
#
# If a curved face is still missed at 8, it is either genuinely part of the
# 8-12 mm bulk shape - in which case radius cannot separate it - or it fails
# recognize_fillets_min_angle (20 degrees), which requires the surface to turn
# at least that much to count as a fillet. Lower that rather than raising the
# radius further. At 5 only the real fillets (1-3 mm) are caught.
    mesh_type                                         = General
    element_type                                      = Mixed
    create_ortho_trias_at_narrow_areas_if_aspect_flag = false
    length_to_width_ratio                             = 2.
    element_order                                     = 1st Order
    2nd_order_nodes_position                          = On geometry
    existing_mesh_treatment                           = Erase
# 1 mm, not 2. Measured on the filleted CAD, a 2 mm target produced tool
# edges of about 0.72 mm at the fillets - the curvature criterion measures
# CHORDAL DEVIATION (0.032 mm on a 2 mm radius, perfectly fine) and has no
# notion of FACET ANGLE, which is what a sliding contact node feels. At
# 0.72 mm on a 2 mm fillet each facet turns 20.6 degrees; on a 1 mm fillet,
# 41 degrees. That is a subdivided version of the sharp corner the fillets
# were added to remove.
#
# Refinement scales with this target rather than with the floor below
# (measured p25 ~ target/2, p5 ~ target/2.7), so halving it roughly halves
# the facet angle. Raising general_curvature_minimum_length does nothing -
# it is a minimum permitted length and is never reached.
    target_element_length                             = 2
    general_curvature_minimum_length                  = 0.1
    remove_perimeters_with_distance                   = 0.35*L
    maintain_thin_sides                               = false
    collapse_fe_junctions_with_distance               = 0.
    non_feature_line_perimeters                       = Fine
    bm_features_handling                              = Clear
# Fix: the STL mesh inherits the geometry orientation set by
# FixGeoAndMesh.orient_tools_towards_blank(). Do not change this - the
# FORMING contacts require the tool normals to point at the blank.
    orientation_definition                            = Fix
    macro_perimeters                                  = Reset
#
# CFD
#
    cfd_interior_growth_rate                   = 1.2
    cfd_distortion_angle_flag                  = true
    cfd_distortion_angle_value                 = 15.
    cfd_anisotropy_max_aspect                  = 1.
    cfd_min_length                             = 1.
    cfd_max_length                             = 1000.
    cfd_auto_length_calculation                = false
    cfd_proximity_between_different_pids_parts = false
    cfd_proximity_based_on                     = Whole model
    cfd_proximity_in_the_same_pid_part         = false
    cfd_max_angle_between_normals              = 40.
    cfd_length_to_gap_refinement_ratio         = 0.3
    cfd_min_proximity_length                   = 1.
    cfd_convex_curvature_treatment             = false
    cfd_reduce_length                          = Maximum
    cfd_reduce_max_length_accounts_sizeents    = false
    cfd_orientation_based_refinement           = false
    cfd_reduction_factor                       = 0.5
    cfd_max_radius_of_curvature                = 1000.
    cfd_orientation_vector_dx                  = 0.
    cfd_orientation_vector_dy                  = 0.
    cfd_orientation_vector_dz                  = -1.
    cfd_max_angle_deviation                    = 60.
#
# STL
#
# stl_distortion_distance is the knob to turn first. It is the maximum
# chordal deviation in mm between the mesh and the real surface, so it
# sets how well tool radii are captured. Tightening it multiplies the
# element count. Rigid bodies cost nothing in time step, but contact
# search and ANSA responsiveness do suffer - if students hit slowness,
# raise this toward 0.1 - 0.2 before touching anything else.
    stl_distortion_distance    = 0.05
    stl_max_length             = 4.
    stl_min_length             = 0.5
    stl_distortion_angle_value = 10.
    stl_distortion_angle_flag  = true
#
# Solids Structural
#
    maximum_aspect_ratio                   = 5.
    feature_line_angle                     = 10.
    structural_proximity                   = false
    structural_max_angle_between_normals   = 40.
    structural_length_to_thickness_ratio   = 2.
    structural_min_refinement_length       = 5.
    structural_force_2_rows_if_width_flag  = false
    structural_force_2_rows_if_width_value = 2.
#
# Perimeters
#
#
# Freeze
#
    freeze_single_perimeters = false
    freeze_triple_perimeters = false
    freeze_double_perimeters = false
    freeze_line_elements     = false
    freeze_named_grids       = false
    freeze_holes_2d          = true
#
# Remove triangles from
#
    remove_triangle_from_spots     = false
    remove_triangle_from_int_perim = false
    remove_triangle_from_ext_perim = false
#
# Zones
#
    attach_zones_on_perimeters_flag      = true
    attach_zones_on_perimeters_value     = 0.35*L
    joined_perimeters_near_washers_flag  = false
    joined_perimeters_near_washers_value = 30.
    create_perims_on_zones               = false
    create_zones_only_on_flat_areas      = true
    create_corner_quads_at_zones         = false
#
# FE Perimeters recognition
#
    recognize_property_bounds_as_perimeters     = true
    recognize_part_bounds_as_perimeters         = true
    recognize_feature_line_bounds_as_perimeters = true
    recognize_feature_line_bounds_option        = Generic
    recognize_feature_line_bounds_angle         = 20.
    recognize_feature_line_bounds_corner_angle  = 40.
    user_defined_feature_lines                  = true
    recognize_feature_line_auto_close           = true
#
# Options
#
    maintain_set_or_include_bounds  = true
    set_perimeters_treatment        = Allow join
    symmetry_plane_treatment        = true
    symmetry_plane_treatment_option = Do not join perimeters
    apply_isospaced_distribution    = false
    treat_perimeters                = false
    rule_perimeter                  = default = true || active = true || name = none || sides = none || angle = none || pid = - || part = - || sets_names = none || treatment = 1
    treatment_perimeter             = 1 || name = none || join = false || join_option = off || distribution = true || spacing_option = auto || number_or_length = none || isospace = false || zones = false || zones_type = specific || specific_zones = none || radial_offset = false || blended = false || smooth_zones = full || proximity_distance_factor = 0. || proximity_distance_option = * last height || cut_faces_on_zones = false || first_height_option = Absolute first height || first_height_value = 0.1 || growth_factor = 1.2 || zones_number_flag = true || zones_number = 5 || max_aspect_flag = true || max_aspect = 0.4 || constant_height_zones_flag = false || constant_height_zones = 2 || separate_angle = 90 || connect_angle = 60 || elements_type = quad
#
# Features
